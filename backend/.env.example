# Application Settings
PROJECT_NAME="AgriKetha-AI Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# MongoDB Configuration
MONGODB_URL="mongodb+srv://<user>:<password>@<cluster-host>/?appName=Cluster0"
DATABASE_NAME="agriketha_ai_db"

# Security & JWT Token Config
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="<generate-a-random-secret>"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging Configuration
LOG_LEVEL="INFO"
LOG_DIR="logs"

# AI Agent Service URLs (for orchestration)
QUERY_AGENT_URL="http://127.0.0.1:8001"
RESEARCH_AGENT_URL="http://127.0.0.1:8004"
# Optional: shared X-Internal-Agent-Key for agent microservices (derived from SECRET_KEY if empty)
INTERNAL_AGENT_KEY=""
